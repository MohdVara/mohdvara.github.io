# Public browser project token from PostHog Project settings (never a personal API key).
VITE_POSTHOG_PROJECT_TOKEN=
# Match the project's region: https://us.i.posthog.com or https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Session replay is disabled in code; the legacy flag is ignored.
