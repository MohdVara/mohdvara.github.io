# Public browser project token from PostHog Project settings (never a personal API key).
VITE_POSTHOG_PROJECT_TOKEN=
# Match the project's region: https://us.i.posthog.com or https://eu.i.posthog.com
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Session replay is disabled in code; the legacy flag is ignored.

# Authoring-only translation tooling. Never prefix these with VITE_.
OPENAI_API_KEY=
OPENAI_TRANSLATION_MODEL=
I18N_CONCURRENCY=2
# Optional model-specific prices; get current rates from your provider.
I18N_INPUT_USD_PER_MILLION=
I18N_OUTPUT_USD_PER_MILLION=
