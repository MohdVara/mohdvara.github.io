{
  "name": "mohdvara-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/pace-rag-assets.mjs && vite",
    "build": "node scripts/pace-rag-assets.mjs && node scripts/technology-evidence.mjs && node scripts/public-github.mjs && tsc -b && vite build && node scripts/prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "predeploy:cloudflare": "npm run build",
    "deploy:cloudflare": "npx wrangler@4 pages deploy",
    "typecheck": "tsc -b",
    "test": "node --test tests/*.test.mjs",
    "refresh:github": "node scripts/public-github.mjs",
    "export:technology": "node scripts/technology-evidence.mjs",
    "check:rag-assets": "node scripts/pace-rag-assets.mjs"
  },
  "dependencies": {
    "@pace-rag/portfolio-assistant": "file:vendor/pace-rag-portfolio-assistant-1.6.1.tgz",
    "phaser": "^3.90.0",
    "posthog-js": "^1.438.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react-swc": "4.3.3",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "gh-pages": "6.1.1",
    "globals": "^15.11.0",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.10.0",
    "vite": "8.3.2"
  }
}
